{
  "manifest_version": 3,
  "name": "OpenFlow for Google Meet",
  "version": "0.1.0",
  "description": "Tells the OpenFlow desktop app who is speaking in Google Meet, so meeting transcripts carry names. Talks only to OpenFlow on this Mac.",
  "key": "",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:8770/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "OpenFlow", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
